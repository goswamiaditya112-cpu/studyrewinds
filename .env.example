PROJECT_NAME=StudyRewinds
ENV=development

# Database Configuration
POSTGRES_USER=studyrewind
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=studyrewind
DATABASE_URL=postgresql+psycopg://studyrewind:your-postgres-password@localhost:5432/studyrewinds_dev
TEST_DATABASE_URL=postgresql+psycopg://studyrewind:your-postgres-password@localhost:5432/studyrewinds_test

# Authentication / JWT Configuration
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
